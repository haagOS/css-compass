{
  "name": "css-compass",
  "displayName": "CSS Compass",
  "version": "0.0.1",
  "private": true,
  "description": "Go to definition, hover and completion for CSS Modules, global classes and custom properties.",
  "categories": [
    "Programming Languages"
  ],
  "publisher": "local",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "build": "node scripts/build.ts",
    "check:size": "node scripts/check-size.ts",
    "package": "pnpm build && pnpm check:size && vsce package --no-dependencies --skip-license --allow-missing-repository",
    "test:integration": "node scripts/build-tests.ts && vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.100.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "activationEvents": [
    "onLanguage:css",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "engines": {
    "node": ">=22.18",
    "vscode": "^1.100.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
