{
  "name": "css-compass",
  "displayName": "CSS Compass",
  "version": "0.0.1",
  "private": true,
  "description": "Go to definition, hover and completion for CSS Modules, global classes and custom properties.",
  "categories": [
    "Programming Languages"
  ],
  "publisher": "local",
  "type": "module",
  "main": "./dist/extension.cjs",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "build": "node scripts/build.ts",
    "check:size": "node scripts/check-size.ts",
    "package": "pnpm build && pnpm check:size && vsce package --no-dependencies --skip-license --allow-missing-repository",
    "test:integration": "node scripts/build-tests.ts && vscode-test",
    "bench": "node scripts/bench.ts"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.20.5",
    "@types/vscode": "1.100.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^4.1.1",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "contributes": {
    "configuration": {
      "title": "CSS Compass",
      "properties": {
        "cssCompass.localsConvention": {
          "type": "string",
          "enum": [
            "asIs",
            "camelCase",
            "camelCaseOnly",
            "dashes",
            "dashesOnly"
          ],
          "default": "asIs",
          "scope": "resource",
          "markdownDescription": "How CSS Module class names map to JS names. Use the same value as `css.modules.localsConvention` in your Vite config."
        },
        "cssCompass.debug.timings": {
          "type": "boolean",
          "default": false,
          "description": "Log how long each request takes to the \"CSS Compass\" output channel."
        }
      }
    },
    "configurationDefaults": {
      "[typescript]": {
        "editor.gotoLocation.multipleDefinitions": "goto"
      },
      "[typescriptreact]": {
        "editor.gotoLocation.multipleDefinitions": "goto"
      },
      "[javascript]": {
        "editor.gotoLocation.multipleDefinitions": "goto"
      },
      "[javascriptreact]": {
        "editor.gotoLocation.multipleDefinitions": "goto"
      }
    }
  },
  "activationEvents": [
    "onLanguage:css",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact"
  ],
  "engines": {
    "node": ">=22.18",
    "vscode": "^1.100.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
