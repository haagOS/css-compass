{
  "name": "css-compass",
  "displayName": "CSS Compass",
  "version": "0.0.1",
  "private": true,
  "description": "Go to definition, hover and completion for CSS Modules, global classes and custom properties.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "typescript": "^6.0.3",
    "vitest": "^5.1.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
